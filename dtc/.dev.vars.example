# ── 本地开发环境变量模板 ──
# 复制此文件为 .dev.vars，填入真实值后即可本地开发

# Turso 数据库连接（必填）
TURSO_URL=https://your-turso-cluster.turso.io
TURSO_TOKEN=your-turso-token

# 管理员令牌（必填，生产环境务必用 wrangler secret put 配置）
ADMIN_TOKEN=dev-only-change-me

# 站点域名（用于 SEO canonical URL）
APP_ORIGIN=http://localhost:8780

# 限流盐值（可选，建议生产环境变更）
RATE_LIMIT_SALT=dtc-local-dev-salt