/* 
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

/dtc/*
  Cache-Control: public, max-age=7200, stale-while-revalidate=86400

/manufacturers/*
  Cache-Control: public, max-age=7200, stale-while-revalidate=86400

/css/*
  Cache-Control: public, max-age=3600
