{
  // ═══ DTC 故障码查询服务 — Workers 配置 ═══
  "name": "dtc",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-24",

  // ═══ 静态资源 ═══
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // ═══ 可观测性 ═══
  "observability": {
    "enabled": true
  },

  // ═══ 环境变量（非敏感，通过 .dev.vars 或 wrangler secret 覆盖） ═══
  "vars": {
    "APP_ORIGIN": "https://dtc.eforge.xyz",
    "RATE_LIMIT_SALT": "change-me-in-production"
  }

  // ═══ Secrets（需通过 wrangler secret put 配置） ═══
  // 必须配置:
  //   TURSO_URL        — Turso 数据库 URL（libsql://xxx.turso.io）
  //   TURSO_TOKEN      — Turso 认证 Token
  //   ADMIN_TOKEN      — 管理后台认证令牌
  //
  // 可选配置:
  //   TURNSTILE_SECRET_KEY      — Cloudflare Turnstile 人机验证密钥
  //
  // 配置命令:
  //   rtk wrangler secret put TURSO_URL
  //   rtk wrangler secret put TURSO_TOKEN
  //   rtk wrangler secret put ADMIN_TOKEN
}
