{
  "name": "@eforge/mach-formulas",
  "version": "0.1.0",
  "description": "数控加工工时与报价计算公式库",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./formulas/math-utils": {
      "import": "./dist/formulas/math-utils.js",
      "types": "./dist/formulas/math-utils.d.ts"
    },
    "./formulas/price-standard": {
      "import": "./dist/formulas/price-standard.js",
      "types": "./dist/formulas/price-standard.d.ts"
    },
    "./formulas/process-time": {
      "import": "./dist/formulas/process-time.js",
      "types": "./dist/formulas/process-time.d.ts"
    },
    "./formulas/cutting-params": {
      "import": "./dist/formulas/cutting-params.js",
      "types": "./dist/formulas/cutting-params.d.ts"
    },
    "./formulas/comprehensive-cost": {
      "import": "./dist/formulas/comprehensive-cost.js",
      "types": "./dist/formulas/comprehensive-cost.d.ts"
    },
    "./formulas/batch-cost": {
      "import": "./dist/formulas/batch-cost.js",
      "types": "./dist/formulas/batch-cost.d.ts"
    },
    "./formulas/milling-time": {
      "import": "./dist/formulas/milling-time.js",
      "types": "./dist/formulas/milling-time.d.ts"
    },
    "./formulas/turning-formulas": {
      "import": "./dist/formulas/turning-formulas.js",
      "types": "./dist/formulas/turning-formulas.d.ts"
    },
    "./formulas/comprehensive-quote": {
      "import": "./dist/formulas/comprehensive-quote.js",
      "types": "./dist/formulas/comprehensive-quote.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "@types/node": "^20.0.0"
  }
}
