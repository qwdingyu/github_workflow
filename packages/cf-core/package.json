    "./http": "./src/http.ts",
    "./security": "./src/security.ts",
    "./rate-limit": "./src/rate-limit.ts",
    "./cache": "./src/cache.ts",
    "./idempotency": "./src/idempotency.ts",
    "./audit": "./src/audit.ts",
    "./config": "./src/config.ts",
    "./bootstrap": "./src/bootstrap.ts",
    "./error": "./src/error.ts",
    "./logger": "./src/logger.ts",
    "./crypto": "./src/crypto.ts",
    "./db": "./src/db/index.ts",
    "./db/schema": "./src/db/schema.ts",
    "./auth/jwt": "./src/auth/jwt.ts",
    "./auth/password": "./src/auth/password.ts",
    "./middleware": "./src/middleware/index.ts",
    "./features/payment": "./features/payment/index.ts",
    "./features/email": "./features/email/index.ts",
    "./features/webhook": "./features/webhook/index.ts",
    "./features/thompson-router": "./features/thompson-router/index.ts",
