{
  "name": "@eforge/cf-core",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Workers 共享内核 — Hono + Turso + Drizzle 标准化基础设施",
  "type": "module",
  "main": "src/index.ts",
