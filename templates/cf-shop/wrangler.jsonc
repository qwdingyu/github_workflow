{
  // 项目名称 — 部署后自动生成 <name>.workers.dev 域名
  "name": "cf-shop",

  // Worker 入口文件
  "main": "src/index.ts",

  // 兼容性日期 — 锁定 Workers 运行时 API 版本
  "compatibility_date": "2026-05-24",

  // 静态资源配置（Cloudflare Assets）
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },

  // 可观测性（日志 + 指标）
  "observability": {
    "enabled": true
  },

  // 非敏感环境变量（敏感值请用 wrangler secret put 设置）
  "vars": {
    "APP_ORIGIN": "https://YOUR_DOMAIN.example.com"
  }

  // ═══════════════════════════════════════════════════════════════
  // 需要 secret put 的敏感变量（由部署脚本自动设置，不要写在这里）：
  //
  //   TURSO_URL                      — 数据库连接 URL
  //   TURSO_TOKEN                    — 数据库认证 Token
  //   ADMIN_TOKEN                    — 管理后台认证
  //   RATE_LIMIT_SALT                — IP 哈希盐值
  //   CREDENTIALS_ENCRYPTION_KEY     — AES-256 加密密钥
  //   JWT_SECRET                     — JWT 签名密钥
  //   TURNSTILE_SECRET_KEY           — Turnstile 人机验证
  //   RESEND_API_KEY                 — Resend 邮件服务（可选）
  //   ALIPAY_APP_ID                  — 支付宝（可选）
  //   ALIPAY_PRIVATE_KEY             — 支付宝（可选）
  //   ALIPAY_PUBLIC_KEY              — 支付宝（可选）
  //
  // 本地开发时写入 .dev.vars 文件（已加入 .gitignore）
  // ═══════════════════════════════════════════════════════════════
}
