---
layout: base.njk
pagination:
  data: seoTopics
  size: 1
  alias: topic
permalink: "{{ topic.url }}"
eleventyComputed:
  title: "{{ topic.title }}"
  description: "{{ topic.description }}"
  keywords: "{{ topic.keywords }}"
  canonical: "{{ config.url }}{{ topic.url }}"
---

<article class="article" role="article">
  <!-- Article Header -->
  <header class="article-header">
    <span class="article-category">
      <a href="/topics-{{ topic.categorySlug }}/">{{ topic.category }}</a>
    </span>
    <h1>{{ topic.title }}</h1>
    <div class="article-meta">
      <time datetime="{{ topic.dateModified }}">{{ topic.dateModified }}</time>
      <span>{{ topic.readingTime }} min read</span>
      <span class="article-type">{{ topic.type | capitalize }}</span>
    </div>
  </header>

  <!-- Table of Contents -->
  <nav class="toc" aria-label="Table of contents">
    <h2>Table of Contents</h2>
    <ol>
      {% for section in topic.content.sections %}
      <li><a href="#{{ section.heading | slugify }}">{{ section.heading }}</a></li>
      {% endfor %}
      {% if topic.content.faqs.length %}
      <li><a href="#faq">FAQ</a></li>
      {% endif %}
    </ol>
  </nav>

  <!-- Article Body -->
  <div class="article-body">
    {% for section in topic.content.sections %}
    <section id="{{ section.heading | slugify }}">
      <h2>{{ section.heading }}</h2>
      <p>{{ section.body }}</p>
    </section>
    {% endfor %}
  </div>

  <!-- FAQ Section (with JSON-LD) -->
  {% if topic.content.faqs.length %}
  <section class="faq-section" id="faq">
    <h2>Frequently Asked Questions</h2>
    {% for faq in topic.content.faqs %}
    <details class="faq-item">
      <summary>{{ faq.question }}</summary>
      <p>{{ faq.answer }}</p>
    </details>
    {% endfor %}
  </section>
  {% endif %}

  <!-- Related Articles -->
  <aside class="related-articles">
    <h2>Related Articles</h2>
    <ul>
      {% set relatedTopics = categoryIndex[topic.category] %}
      {% set count = 0 %}
      {% for r in relatedTopics %}
      {% if r.url != topic.url and count < 5 %}
      <li><a href="{{ r.url }}">{{ r.title }}</a></li>
      {% set count = count + 1 %}
      {% endif %}
      {% endfor %}
    </ul>
  </aside>
</article>

<!-- Article JSON-LD Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ topic.title | json }},
  "description": {{ topic.description | json }},
  "url": {{ config.url ~ topic.url | json }},
  "dateModified": {{ topic.dateModified | json }},
  "author": {
    "@type": "Organization",
    "name": {{ config.siteName | json }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ config.siteName | json }},
    "url": {{ config.url | json }}
  },
  "mainEntityOfPage": {{ config.url ~ topic.url | json }},
  "keywords": {{ topic.keywords | json }}
}
</script>

<!-- FAQ JSON-LD Schema -->
{% if topic.content.faqs.length %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for faq in topic.content.faqs %}
    {
      "@type": "Question",
      "name": {{ faq.question | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ faq.answer | json }}
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
