---
layout: base.njk
pagination:
  data: "seoTopics"
  size: 50
  alias: "pageTopics"

permalink: "/topics/page-{{ pagination.pageNumber }}/"
eleventyComputed:
  title: "Articles Page {{ pagination.pageNumber + 1 }} — {{ config.siteName }}"
  description: "Articles page {{ pagination.pageNumber + 1 }}. Browse expert guides, comparisons, and tutorials."
  canonical: "{{ config.url }}/topics/page-{{ pagination.pageNumber }}/"
---

<section class="topic-list">
  <h1>Articles — Page {{ pagination.pageNumber + 1 }}</h1>

  <ul>
    {% for t in pageTopics %}
    <li class="topic-item">
      <h2><a href="{{ t.url }}">{{ t.title }}</a></h2>
      <p>{{ t.description | truncate(140) }}</p>
      <div class="topic-meta">
        <span class="topic-category"><a href="/topics-{{ t.categorySlug }}/">{{ t.category }}</a></span>
        <span class="topic-type">{{ t.type }}</span>
        <time datetime="{{ t.dateModified }}">{{ t.dateModified }}</time>
        <span>{{ t.readingTime }} min read</span>
      </div>
    </li>
    {% endfor %}
  </ul>

  <!-- Pagination -->
  <nav class="pagination" aria-label="Topics pagination">
    {% if pagination.previousUrl %}
    <a href="{{ pagination.previousUrl }}" rel="prev">&laquo; Previous</a>
    {% endif %}
    <span class="pagination-info">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
    {% if pagination.nextUrl %}
    <a href="{{ pagination.nextUrl }}" rel="next">Next &raquo;</a>
    {% endif %}
  </nav>
</section>
