---
layout: base.njk
permalink: /
eleventyComputed:
  title: "{{ config.siteName }}"
  description: "{{ config.description }}"
  canonical: "{{ config.url }}/"
---

<section class="hero">
  <h1>{{ config.siteName }}</h1>
  <p>{{ config.description }}</p>
</section>

<section class="category-section">
  <h2>SEO Tools</h2>
  <div class="tools-grid">
    {% for tool in tools %}
    <a href="/tools/{{ tool.slug }}/" class="tool-card">
      <span class="tool-icon">{{ tool.icon }}</span>
      <h3>{{ tool.title }}</h3>
      <p>{{ tool.description }}</p>
    </a>
    {% endfor %}
  </div>
</section>

<section class="category-section">
  <h2>Why SEO Toolkit?</h2>
  <div class="tools-grid features-grid">
    <div class="feature-card">
      <h3>⚡ Instant</h3>
      <p>Pure client-side tools. No server calls, no waiting. Results appear as you type.</p>
    </div>
    <div class="feature-card">
      <h3>🔒 Private</h3>
      <p>Your data never leaves your browser. No tracking, no analytics on your input, no cookies.</p>
    </div>
    <div class="feature-card">
      <h3>📱 Responsive</h3>
      <p>Works on any device. Mobile, tablet, desktop — all tools adapt to your screen.</p>
    </div>
    <div class="feature-card">
      <h3>🆓 Free</h3>
      <p>100% free, no signup required. No premium tiers, no hidden fees. Ever.</p>
    </div>
  </div>
</section>
