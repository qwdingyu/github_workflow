---
layout: base.njk
---

<article class="tool-page">
  <header>
    <h1>{{ tool.icon }} {{ tool.title }}</h1>
    <p class="description">{{ tool.description }}</p>
  </header>

  {{ content | safe }}

  <!-- Related Tools -->
  <section class="related-tools">
    <h3>Related Tools</h3>
    <div class="related-tools-grid">
      {% set currentSlug = tool.slug %}
      {% for t in tools %}
      {% if t.slug != currentSlug %}
      <a href="/tools/{{ t.slug }}/" class="related-tool-card">
        <span class="tool-icon">{{ t.icon }}</span>
        <h4>{{ t.title }}</h4>
        <p>{{ t.description | truncate(80) }}</p>
      </a>
      {% endif %}
      {% endfor %}
    </div>
  </section>
</article>

<section class="guardian-cta">
  <div class="guardian-cta-inner">
    <div class="guardian-cta-text">
      <h2>🛡️ Try SEO Guardian — Free for 7 Days</h2>
      <p>This tool checks your page <strong>once</strong>. SEO Guardian monitors your site <strong>every day</strong> with AI-powered insights.</p>
      <ul>
        <li>✅ Daily automated SEO scans</li>
        <li>✅ AI diagnoses <em>why</em> your rankings dropped</li>
        <li>✅ Instant email alerts when issues are found</li>
        <li>✅ Weekly AI-generated SEO reports</li>
      </ul>
    </div>
    <div class="guardian-cta-action">
      <a href="/guardian/signup" class="btn-primary btn-cta">Start Free Trial →</a>
      <span class="cta-note">No credit card required</span>
    </div>
  </div>
</section>

{% if toolScript %}
<script src="{{ toolScript }}"></script>
{% endif %}

<!-- SoftwareApplication Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "{{ tool.title }}",
  "description": "{{ tool.description }}",
  "url": "{{ canonical | default(config.url ~ page.url) }}",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "ratingCount": "100"
  }
}
</script>
