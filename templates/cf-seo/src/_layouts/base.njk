<!DOCTYPE html>
<html lang="{{ config.locale | default('en-US') }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="{{ config.themeColor | default('#2563eb') }}">
  <meta name="mobile-web-app-capable" content="yes">

  <title>{% if title and title != config.siteName %}{{ title }} — {{ config.siteName }}{% else %}{{ config.siteName }}{% endif %}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}

  {% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title | default(config.siteName) }}">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  {% if canonical %}<meta property="og:url" content="{{ canonical }}">{% endif %}
  <meta property="og:site_name" content="{{ config.siteName }}">
  <meta property="og:locale" content="{{ config.locale }}">
  {% if config.ogImage %}<meta property="og:image" content="{{ config.url }}{{ config.ogImage }}">{% endif %}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title | default(config.siteName) }}">
  {% if description %}<meta name="twitter:description" content="{{ description }}">{% endif %}
  {% if config.ogImage %}<meta name="twitter:image" content="{{ config.url }}{{ config.ogImage }}">{% endif %}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preload" href="/assets/styles.css" as="style">
  <link rel="stylesheet" href="/assets/styles.css">

  {% if config.ga4Id %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ config.ga4Id }}"></script>
  <script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ config.ga4Id }}', { send_page_view: true });
  </script>
  {% endif %}
</head>
<body>
  <header>
    <nav class="navbar" aria-label="Main navigation">
      <a href="/" class="logo">{{ config.siteName }}</a>
      <div class="nav-links">
        {% for t in tools | limit(5) %}
        <a href="/tools/{{ t.slug }}/" {% if page.url and page.url | startsWith('/tools/' ~ t.slug) %}class="active"{% endif %}>{{ t.title }}</a>
        {% endfor %}
      </div>
    </nav>
  </header>

  <main role="main">
    {% if page.url and page.url != '/' %}
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/">Home</a>
      › <span>{{ title }}</span>
    </nav>
    {% endif %}

    {{ content | safe }}
  </main>

  <footer aria-label="Footer">
    <div class="footer-content">
      <div class="footer-section">
        <p>&copy; {{ currentYear }} {{ config.siteName }}. All rights reserved.</p>
        <nav aria-label="Footer links" class="footer-nav">
          {% if config.footerLinks %}
          {% for link in config.footerLinks %}
          <a href="{{ link.url }}">{{ link.label }}</a>
          {% endfor %}
          {% else %}
          <a href="/about/">About</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          {% endif %}
        </nav>
      </div>
      {% if config.social %}
      <div class="footer-section footer-social">
        {% if config.social.github %}<a href="{{ config.social.github }}" target="_blank" rel="noopener noreferrer">GitHub</a>{% endif %}
        {% if config.social.twitter %}<a href="{{ config.social.twitter }}" target="_blank" rel="noopener noreferrer">Twitter</a>{% endif %}
      </div>
      {% endif %}
    </div>
  </footer>

  <!-- JSON-LD: WebSite (homepage only) -->
  {% if page.url == '/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ config.siteName }}",
    "url": "{{ config.url }}",
    "description": "{{ config.description }}"
  }
  </script>
  {% endif %}

  <!-- JSON-LD: BreadcrumbList (non-homepage) -->
  {% if page.url and page.url != '/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ config.url }}/" },
      { "@type": "ListItem", "position": 2, "name": "{{ title }}", "item": "{{ canonical | default(config.url ~ page.url) }}" }
    ]
  }
  </script>
  {% endif %}
</body>
</html>
