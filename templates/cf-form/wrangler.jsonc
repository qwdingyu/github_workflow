{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-form",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Turso 数据库通过环境变量配置（非 D1）
  // 部署时通过 wrangler secret put 设置：
  //   TURSO_URL    — Turso 数据库 URL（libsql://xxx.turso.io）
  //   TURSO_TOKEN  — Turso 认证 Token
  "vars": {
    "APP_NAME": "CF Form",
    "DEFAULT_FORM_SLUG": "contact",
    "RATE_LIMIT_SALT": "replace-with-wrangler-secret-in-production"
  }
}
