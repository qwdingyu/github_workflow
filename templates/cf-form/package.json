{
  "name": "cf-form",
  "version": "0.2.0",
  "private": true,
  "description": "Cloudflare Workers + Turso JSON 驱动动态表单系统",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "deploy:full": "bash .deploy/one-click.sh",
    "smoke:shared": "bash .deploy/tests/test-shared.sh"
  },
  "dependencies": {
    "@eforge/cf-core": "file:../../packages/cf-core",
    "@hono/zod-validator": "^0.8.0",
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.22",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260524.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.94.0"
  }
}
