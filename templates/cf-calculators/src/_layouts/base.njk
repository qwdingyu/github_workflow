<!DOCTYPE html>
<html lang="{{ config.locale | default('zh-CN') }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#6366f1">
  <meta name="mobile-web-app-capable" content="yes">

  <!-- SEO Meta Tags -->
  <title>{% if title and title != config.siteName %}{{ title }} — {{ config.siteName }}{% else %}{{ config.siteName }}{% endif %}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}

  <!-- Canonical URL -->
  {% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}

  <!-- Open Graph -->
  <meta property="og:type" content="{{ ogType | default('website') }}">
  <meta property="og:title" content="{{ title | default(config.siteName) }}">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  {% if canonical %}<meta property="og:url" content="{{ canonical }}">{% endif %}
  <meta property="og:site_name" content="{{ config.siteName }}">
  <meta property="og:locale" content="{{ config.locale }}">
  {% if config.ogImage %}<meta property="og:image" content="{{ config.url }}{{ config.ogImage }}">{% endif %}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title | default(config.siteName) }}">
  {% if description %}<meta name="twitter:description" content="{{ description }}">{% endif %}
  {% if config.ogImage %}<meta name="twitter:image" content="{{ config.url }}{{ config.ogImage }}">{% endif %}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- Critical CSS: Preload stylesheet for faster LCP -->
  <link rel="preload" href="/assets/styles.css" as="style">
  <!-- Styles -->
  <link rel="stylesheet" href="/assets/styles.css">

  <!-- Google Analytics 4 -->
  {% if config.ga4Id %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ config.ga4Id }}"></script>
  <script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '{{ config.ga4Id }}', { send_page_view: true });
  </script>
  {% endif %}
</head>
<body>
  <header>
    <nav class="navbar" aria-label="主导航">
      <a href="/" class="logo">{{ config.siteName }}</a>
      <div class="nav-links">
        <a href="/tools-index/">所有工具</a>
        <a href="/posts/">博客</a>
        <a href="/docs/">文档</a>
      </div>
    </nav>
  </header>

  <main role="main">
    <!-- Breadcrumb Navigation (hidden on homepage and index pages) -->
    {% if page.url and page.url != '/' and page.url != '/tools-index/' and page.url != '/posts/' and page.url != '/docs/' %}
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/">首页</a>
      {% if '/tools/' in page.url %}
      › <a href="/tools-index/">工具</a> › <span>{{ title }}</span>
      {% elif '/posts/' in page.url %}
      › <a href="/posts/">博客</a> › <span>{{ title }}</span>
      {% elif '/docs/' in page.url %}
      › <a href="/docs/">文档</a> › <span>{{ title }}</span>
      {% endif %}
    </nav>
    {% endif %}

    {{ content | safe }}
  </main>

  <footer aria-label="页脚">
    <div class="footer-content">
      <div class="footer-section">
        <p>&copy; 2026 {{ config.siteName }}. 保留所有权利。</p>
        <nav aria-label="辅助链接" class="footer-nav">
          {% if config.footerLinks %}
          {% for link in config.footerLinks %}
          <a href="{{ link.url }}">{{ link.label }}</a>
          {% endfor %}
          {% else %}
          <a href="/about/">关于我们</a>
          <a href="/privacy/">隐私政策</a>
          <a href="/terms/">服务条款</a>
          <a href="/sitemap.xml">站点地图</a>
          <a href="/robots.txt">Robots</a>
          {% endif %}
        </nav>
      </div>
      {% if config.social %}
      <div class="footer-section footer-social">
        <span>社交媒体：</span>
        {% if config.social.github %}<a href="{{ config.social.github }}" target="_blank" rel="noopener noreferrer">GitHub</a>{% endif %}
        {% if config.social.weibo %}<a href="{{ config.social.weibo }}" target="_blank" rel="noopener noreferrer">微博</a>{% endif %}
        {% if config.social.zhihu %}<a href="{{ config.social.zhihu }}" target="_blank" rel="noopener noreferrer">知乎</a>{% endif %}
        {% if config.social.juejin %}<a href="{{ config.social.juejin }}" target="_blank" rel="noopener noreferrer">掘金</a>{% endif %}
      </div>
      {% endif %}
      {% if config.wechat %}
      <div class="footer-section footer-wechat">
        <img src="{{ config.wechat.qrcode }}" alt="微信公众号二维码" width="120" height="120">
        <p>关注公众号，获取最新工具更新</p>
      </div>
      {% endif %}
    </div>
  </footer>

  <!-- JSON-LD Structured Data -->

  <!-- WebSite Schema (首页 only) -->
  {% if page.url == '/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ config.siteName }}",
    "url": "{{ config.url }}",
    "description": "{{ config.description }}",
    "inLanguage": "{{ config.locale }}",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "{{ config.url }}/tools-index/?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  {% endif %}

  <!-- Organization Schema (首页 only) -->
  {% if page.url == '/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ config.siteName }}",
    "url": "{{ config.url }}"
  }
  </script>
  {% endif %}

  <!-- BreadcrumbList Schema (非首页，排除索引页) -->
  {% if page.url and page.url != '/' and page.url != '/tools-index/' and page.url != '/posts/' and page.url != '/docs/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "首页",
        "item": "{{ config.url }}/"
      }
      {% if '/tools/' in page.url %}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": "工具",
        "item": "{{ config.url }}/tools-index/"
      },{
        "@type": "ListItem",
        "position": 3,
        "name": "{{ title }}",
        "item": "{{ canonical | default(config.url ~ page.url) }}"
      }
      {% elif '/posts/' in page.url %}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": "博客",
        "item": "{{ config.url }}/posts/"
      },{
        "@type": "ListItem",
        "position": 3,
        "name": "{{ title }}",
        "item": "{{ canonical | default(config.url ~ page.url) }}"
      }
      {% elif '/docs/' in page.url %}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": "文档",
        "item": "{{ config.url }}/docs/"
      },{
        "@type": "ListItem",
        "position": 3,
        "name": "{{ title }}",
        "item": "{{ canonical | default(config.url ~ page.url) }}"
      }
      {% endif %}
    ]
  }
  </script>
  {% endif %}

  <!-- Floating WeChat Contact Button -->
  {% if config.wechat and config.wechat.account %}
  <a href="https://weixin.qq.com/" target="_blank" rel="noopener noreferrer"
     style="position: fixed; bottom: 20px; right: 20px; z-index: 9999;
            background-color: #07c160; color: #fff; border-radius: 8px;
            padding: 12px 16px; box-shadow: 0 2px 12px rgba(0,0,0,0.15);
            text-decoration: none; display: flex; align-items: center; gap: 8px;
            font-size: 14px; line-height: 1;
            transition: box-shadow 0.2s ease;"
     onmouseover="this.style.boxShadow='0 4px 20px rgba(0,0,0,0.25)'"
     onmouseout="this.style.boxShadow='0 2px 12px rgba(0,0,0,0.15)'"
     title="联系客服">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>
    微信咨询
  </a>
  {% endif %}
</body>
</html>
