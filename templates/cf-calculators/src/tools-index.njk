---
layout: base.njk
title: 所有工具
description: 免费在线开发工具集合
eleventyComputed:
  canonical: "{{ config.url }}/tools-index/"
---

<section class="tools-list">
  <h1>所有工具</h1>
  <p class="description">免费在线开发工具集合，所有操作在浏览器中完成</p>

  <div class="tools-grid">
    {% for tool in tools %}
    <a href="/tools/{{ tool.slug }}/" class="tool-card">
      <span class="tool-icon">{{ tool.icon | default('🔧') }}</span>
      <h3>{{ tool.title }}</h3>
      <p>{{ tool.description }}</p>
      {% if tool.category %}
      <span class="tool-category">{{ tool.category }}</span>
      {% endif %}
    </a>
    {% endfor %}
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "所有工具",
  "description": "免费在线开发工具集合，包含格式化工具、编解码工具、加密工具、文本处理、生成器和财务计算器",
  "url": "{{ config.url }}/tools-index/",
  "hasPart": [
    {% for tool in tools %}
    {
      "@type": "SoftwareApplication",
      "name": "{{ tool.title }}",
      "url": "{{ config.url }}/tools/{{ tool.slug }}/"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
