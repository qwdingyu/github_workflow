# ═══════════════════════════════════════════════════════════════
# cf-auth 云服务器 / Node 原生部署用 .env 模板
# 复制为 /opt/cf-auth/.env 后按实值填写。切勿提交真实密钥。
# 对齐：src/server.ts、src/lib/env.ts、src/bindings.ts
# ═══════════════════════════════════════════════════════════════

# ── 进程 ──────────────────────────────────────────────────────
PORT=8788
# systemd 单元默认再设 HOST=127.0.0.1；仅本机调试可 0.0.0.0
HOST=127.0.0.1
NODE_ENV=production

# nginx 反代后必须为 true，否则 getClientIp 读不到 X-Forwarded-For
TRUST_PROXY_HEADERS=true

# ── Better Auth（生产必须与对外域名一致）────────────────────
# ≥32 字符；一旦上线勿随意更换（会牵动 JWKS / session，见历史事故）
BETTER_AUTH_SECRET=replace-with-random-at-least-32-chars-long

# 对外 issuer / baseURL：必须是用户浏览器访问的 https 根
BETTER_AUTH_URL=https://auth.eforge.xyz
APP_ORIGIN=https://auth.eforge.xyz

# 含自身与各 RP 前端 origin（逗号分隔、无尾斜杠）
TRUSTED_ORIGINS=https://auth.eforge.xyz,https://lucky.eforge.xyz,https://shop.eforge.xyz

# skip_consent 允许的 redirect 主机名
FIRST_PARTY_REDIRECT_HOSTS=localhost,127.0.0.1,auth.eforge.xyz,lucky.eforge.xyz,shop.eforge.xyz

# ── 数据库（二选一）──────────────────────────────────────────
# A) 本机 SQLite（推荐与 lottery 051 同风格；务必备份 data/）
DATABASE_URL=file:./data/local.db
# TURSO_URL=
# TURSO_TOKEN=

# B) 继续用远程 Turso（少迁库；大陆到 Turso 延迟需自测）
# DATABASE_URL=libsql://YOUR-DB.turso.io
# TURSO_URL=libsql://YOUR-DB.turso.io
# TURSO_TOKEN=

# ── 社交登录（成对；缺一则该渠道不启用）────────────────────
ENABLED_SOCIAL_PROVIDERS=google,github
# Google 回调须为：https://auth.eforge.xyz/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub 回调须为：https://auth.eforge.xyz/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

EMAIL_PASSWORD_ENABLED=true

# ── 平台管理员 ──────────────────────────────────────────────
# 未配置时 /api/admin/* → 503
ADMIN_EMAILS=you@example.com
# ADMIN_USER_IDS=
# 脚本用 Header: X-Admin-Api-Key
ADMIN_API_KEY=replace-with-long-random-string
# Admin 写请求 CSRF 信任域：默认仅同源（Admin SPA 由本站托管）；
# 管理入口不在本站时（内网管理域/dev 代理）才需要显式配置，与 TRUSTED_ORIGINS 解耦
# ADMIN_TRUSTED_ORIGINS=https://admin.example.com
