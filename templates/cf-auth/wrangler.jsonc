{
  // cf-auth：统一认证服务（OAuth/OIDC Provider）
  // 生产：auth.eforge.xyz + Turso cf-auth-db（非 Free D1）
  "name": "cf-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-24",
  // better-auth / 部分依赖可能触达 Node API；与常见 Workers+Auth 实践一致
  "workers_dev": true,
  "compatibility_flags": ["nodejs_compat"],

  "routes": [
    { "pattern": "auth.eforge.xyz", "custom_domain": true }
  ],

  // 生产库走 secrets：DATABASE_URL / TURSO_URL + TURSO_TOKEN（Turso）
  // D1 空库 cf-auth 保留在账号内作实验，不绑定本 Worker，避免误用 Free 配额

  "vars": {
    "APP_ORIGIN": "https://auth.eforge.xyz",
    "BETTER_AUTH_URL": "https://auth.eforge.xyz",
    "ENABLED_SOCIAL_PROVIDERS": "google,github",
    "EMAIL_PASSWORD_ENABLED": "true",
    "TRUSTED_ORIGINS": "https://auth.eforge.xyz,https://lucky.eforge.xyz,https://shop.eforge.xyz,http://localhost:8788,http://localhost:8787",
    // skip_consent 允许的 redirect hostname（逗号分隔）；未设时代码默认含 localhost + eforge 域
    "FIRST_PARTY_REDIRECT_HOSTS": "localhost,127.0.0.1,auth.eforge.xyz,lucky.eforge.xyz,shop.eforge.xyz"
  },

  // ADMIN_EMAILS / ADMIN_USER_IDS / ADMIN_API_KEY：用 wrangler secret 或临时 vars，勿把真实邮箱写进公开 fork
  // ADMIN_TRUSTED_ORIGINS（可选）：Admin 写请求 CSRF 信任域，默认仅同源；管理入口不在本站时才配置，与 TRUSTED_ORIGINS 解耦

  // Admin SPA（frontend vite → public/）；协议与 API 优先进 Worker
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    // 协议页与 API 必须进 Worker；Admin SPA 走 ASSETS（/admin、/assets）
    "run_worker_first": [
      "/api/*",
      "/sign-in",
      "/sign-in/*",
      "/consent",
      "/consent/*",
      "/.well-known/*",
      // 裸 /admin 无尾斜杠时 Assets SPA 可能 404；进 Worker 回退 index.html
      "/admin",
      "/"
    ]
  },

  "observability": {
    "enabled": true
  }

  // secrets（wrangler secret put，勿写入本文件）：
  // BETTER_AUTH_SECRET
  // DATABASE_URL / TURSO_URL / TURSO_TOKEN
  // GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
  // GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET
  // ADMIN_EMAILS / ADMIN_API_KEY（可选）
}
