# cf-auth RP 最小示例 (Hono + Node)
# 从 Admin → OAuth 应用创建后复制

# cf-auth 部署地址
CF_AUTH_ISSUER=https://auth.eforge.xyz

# 从 Admin 创建 OAuth 应用时得到（secret 仅显示一次！）
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# 回调地址（必须在 Admin 的 redirect_uris 中登记，含 http://localhost:3000）
REDIRECT_URI=http://localhost:3000/callback

# 本 RP 的本地 session JWT secret（随机长字符串）
RP_JWT_SECRET=replace-with-random-secret-at-least-32-chars
