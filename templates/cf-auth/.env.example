# ═══════════════════════════════════════════════════════════════
# cf-auth 环境变量示例
# 复制为 .env 后本地：npm run dev:local
# ═══════════════════════════════════════════════════════════════

# Better Auth 密钥（≥32 字符）
BETTER_AUTH_SECRET=local-dev-better-auth-secret-at-least-32-chars

# 对外 base URL（本地 8788，生产 https://auth.eforge.xyz）
BETTER_AUTH_URL=http://localhost:8788

# 信任的 Origin（逗号分隔；含自身与各 RP）
TRUSTED_ORIGINS=http://localhost:8788,http://localhost:8787,https://lucky.eforge.xyz,https://auth.eforge.xyz

# 数据库：
# 本地离线：file:./data/local.db
# 生产 / Cloudflare：Turso 独立库 cf-auth-db（见 docs/010）
# DATABASE_URL=file:./data/local.db
DATABASE_URL=libsql://cf-auth-db-qwsky.aws-ap-northeast-1.turso.io
TURSO_URL=libsql://cf-auth-db-qwsky.aws-ap-northeast-1.turso.io
# TURSO_TOKEN=   # turso db tokens create cf-auth-db -e none（勿提交）

# ── 上游社交 IdP（成对配置；缺一则该 provider 不启用）────────
# 可选白名单：只开列出的 id（默认=凡密钥齐全都开）
# ENABLED_SOCIAL_PROVIDERS=google,github

# Google — 在 Google Cloud Console 登记 Authorized redirect URI：
#   http://localhost:8788/api/auth/callback/google
#   https://auth.eforge.xyz/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub — 在 OAuth App 设置 Authorization callback URL：
#   http://localhost:8788/api/auth/callback/github
#   （生产另建 App 或改用 https://auth.eforge.xyz/api/auth/callback/github）
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Microsoft Entra — 回调：.../callback/microsoft
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Apple（client secret 常为轮换 JWT，生产前单独验证）
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Discord / GitLab
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=

# 邮箱密码：本地默认 true；生产可 EMAIL_PASSWORD_ENABLED=false 仅社交
# 注意：平台 Admin 登录若走邮箱密码，需保持 true（或管理员先社交登录再进 /admin）
# EMAIL_PASSWORD_ENABLED=true

# ── 邮件发送加密密钥（docs/030）──────────────────────────────
# AES-256-GCM 加密 ≥32 字节 hex，DB email_config 密码/api key 的加密密钥。
# 不配则邮箱验证码不可用（不阻塞注册）。通道配置通过 Admin → 邮件配置管理。
# EMAIL_ENCRYPTION_KEY=

# ── 邮件网关 API（docs/093）──────────────────────────────────
# POST /api/email/send 对外提供邮件发送服务。消费方（cf-shop/cf-lottery 等）
# 在 Admin → Clients 页创建 OAuth App 并开启「邮箱发送」后，携带 Basic Auth 调用。
# 生产已启用，无需额外 env 配置。

# ── 平台管理员（docs/013 M7 / docs/015）──────────────────────
# 未配置时 /api/admin/* 返回 503；开放 create-client 亦被收口
# 逗号分隔邮箱（小写比对）
# ADMIN_EMAILS=you@eforge.xyz
# 或用户 id 白名单
# ADMIN_USER_IDS=
# 脚本 / CI（Header: X-Admin-Api-Key 或 Authorization: Bearer）
# ADMIN_API_KEY=replace-with-long-random-string

# Admin 写请求 CSRF 信任域（逗号分隔 origin；docs/013 §5.6）。
# 默认仅同源（Admin SPA 由本站托管，零配置即用）；仅当管理入口不在本站
# （内网管理域 / dev 代理 / 独立管理域）时显式补充。与业务 TRUSTED_ORIGINS 解耦。
# ADMIN_TRUSTED_ORIGINS=https://admin.example.com

# skip_consent 仅允许这些 redirect hostname（逗号分隔；未设则用代码默认）
# FIRST_PARTY_REDIRECT_HOSTS=localhost,127.0.0.1,auth.eforge.xyz,lucky.eforge.xyz

# Node 反代后才开启
# TRUST_PROXY_HEADERS=true

PORT=8788
# 监听地址：本地调试 0.0.0.0；systemd 生产建议 127.0.0.1（见 scripts/cf-auth.service）
# HOST=0.0.0.0

# 云服务器完整模板见 scripts/env.cloud-server.example
# 部署指南 docs/028_云服务器与Node原生部署_2026-08-04.md
