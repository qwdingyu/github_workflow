{
  "name": "cf-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "独立 Better Auth 统一认证服务（OAuth/OIDC Provider）",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "dev:local": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "dev:admin": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/migrate.mjs",
    "smoke:auth": "vitest run src/auth-core.test.ts",
    "smoke:oauth": "vitest run src/oauth-provider.test.ts",
    "deploy": "npm run build:frontend && wrangler deploy",
    "deploy:prod": "bash local-deploy.sh",
    "deploy:node": "bash scripts/setup-cloud-server.sh",
    "deploy:node:update": "bash scripts/update-cloud-server.sh",
    "verify": "npm run type-check && npm test",
    "verify:social": "tsx scripts/verify-real-social.mjs",
    "smoke:prod": "node scripts/prod-smoke.mjs"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.6.25",
    "@hono/node-server": "^2.0.12",
    "@libsql/client": "^0.14.0",
    "@usethink/cf-core": "^0.5.2",
    "better-auth": "1.6.25",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "hono": "^4.12.22",
    "tsx": "^4.23.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260726.1",
    "@types/node": "^22.15.0",
    "typescript": "5.7.3",
    "vitest": "4.1.7",
    "wrangler": "4.114.0"
  }
}
