{
  // ═══ 基本配置 ═══
  "name": "cf-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-24",

  // ═══ 静态资源 ═══
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // ═══ 可观测性 ═══
  "observability": {
    "enabled": true
  },

  // ═══ 环境变量（非敏感） ═══
  "vars": {
    "APP_ORIGIN": "",
    "RATE_LIMIT_SALT": "change-me-in-production"
  }

  // ═══ Secrets（需通过 wrangler secret put 配置） ═══
  // 必须配置:
  //   TURSO_URL        — Turso 数据库 URL（libsql://xxx.turso.io）
  //   TURSO_TOKEN      — Turso 认证 Token
  //   ADMIN_TOKEN      — 管理后台认证令牌
  //
  // 可选配置:
  //   TURNSTILE_SECRET_KEY      — Cloudflare Turnstile 人机验证密钥
  //   CREDENTIALS_ENCRYPTION_KEY — AES-256 加密密钥（64 字符 hex）
  //
  // 配置命令:
  //   wrangler secret put TURSO_URL
  //   wrangler secret put TURSO_TOKEN
  //   wrangler secret put ADMIN_TOKEN
}
