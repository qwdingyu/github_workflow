<form class="calculator-form" onsubmit="return false;">
  <div class="form-group">
    <label for="salary">税前月薪（元）</label>
    <input type="number" id="salary" placeholder="如 20000" min="0" step="100">
  </div>

  <div class="form-group">
    <label for="city">所在城市</label>
    <select id="city">
      <option value="">请选择城市</option>
    </select>
  </div>

  <div class="form-group">
    <label for="housingRate">公积金比例（%）</label>
    <input type="number" id="housingRate" value="12" min="5" max="12" step="1">
    <small class="form-hint">范围 5% - 12%，由单位政策决定</small>
  </div>

  <button type="button" id="calculateBtn" class="btn-primary">计算五险一金</button>
</form>

<div id="result" style="display:none;" class="calculator-result"></div>
