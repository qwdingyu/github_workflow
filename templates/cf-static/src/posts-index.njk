---
layout: base.njk
title: Blog
description: DevTools tutorials and technical articles
permalink: /posts/index.html
eleventyComputed:
  canonical: "{{ config.url }}/posts/"
---

<section class="posts-list">
  <h1>Blog</h1>
  <p class="description">DevTools tutorials and technical articles</p>

  <div class="posts-grid">
    {% for post in posts %}
    <a href="/posts/{{ post.slug }}/" class="post-card">
      <h3>{{ post.title }}</h3>
      <p>{{ post.description }}</p>
      <div class="post-meta">
        <time datetime="{{ post.date }}">{{ post.date }}</time>
        {% if post.author %}<span class="author">{{ post.author }}</span>{% endif %}
      </div>
    </a>
    {% endfor %}
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Blog",
  "description": "DevTools tutorials and technical articles",
  "url": "{{ config.url }}/posts/",
  "blogPost": [
    {% for post in posts %}
    {
      "@type": "BlogPosting",
      "headline": "{{ post.title }}",
      "description": "{{ post.description }}",
      "datePublished": "{{ post.date }}",
      "url": "{{ config.url }}/posts/{{ post.slug }}/"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
