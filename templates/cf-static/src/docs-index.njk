---
layout: base.njk
title: 文档
description: 在线开发工具使用文档
permalink: /docs/index.html
eleventyComputed:
  canonical: "{{ config.url }}/docs/"
---

<section class="docs-list">
  <h1>文档</h1>
  <p class="description">在线开发工具使用文档</p>

  <div class="docs-grid">
    {% for doc in docs %}
    <a href="/docs/{{ doc.slug }}/" class="doc-card">
      <h3>{{ doc.title }}</h3>
      <p>{{ doc.description }}</p>
    </a>
    {% endfor %}
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "文档",
  "description": "在线开发工具使用文档",
  "url": "{{ config.url }}/docs/",
  "hasPart": [
    {% for doc in docs %}
    {
      "@type": "CreativeWork",
      "name": "{{ doc.title }}",
      "description": "{{ doc.description }}",
      "url": "{{ config.url }}/docs/{{ doc.slug }}/"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
