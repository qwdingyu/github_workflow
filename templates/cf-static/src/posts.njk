---
layout: base.njk
pagination:
  data: posts
  size: 1
  alias: post
permalink: "/posts/{{ post.slug }}/"
eleventyComputed:
  title: "{{ post.title }}"
  description: "{{ post.description }}"
  canonical: "{{ config.url }}{{ page.url }}"
---

<article class="post">
  <header>
    <h1>{{ post.title }}</h1>
    <div class="post-meta">
      <time datetime="{{ post.date }}">{{ post.date }}</time>
      {% if post.author %}<span class="author">By {{ post.author }}</span>{% endif %}
    </div>
  </header>

  <div class="post-content">
    {{ post.content | safe }}
  </div>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ post.title }}",
  "description": "{{ post.description }}",
  "datePublished": "{{ post.date }}",
  "dateModified": "{{ post.date }}",
  "author": {
    "@type": "Organization",
    "name": "{{ post.author | default('DevTools Team') }}"
  },
  "publisher": {
    "@type": "Organization",
    "name": "{{ config.siteName }}",
    "url": "{{ config.url }}"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ canonical | default(config.url ~ page.url) }}"
  }
}
</script>
