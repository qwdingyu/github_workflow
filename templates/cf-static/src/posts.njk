---
layout: base.njk
pagination:
  data: posts
  size: 1
  alias: post
permalink: "/posts/{{ post.slug }}/"
eleventyComputed:
  title: "{{ post.title }}"
  description: "{{ post.description }}"
---

<article class="post">
  <header>
    <h1>{{ post.title }}</h1>
    <div class="post-meta">
      <time datetime="{{ post.date }}">{{ post.date }}</time>
      {% if post.author %}<span class="author">作者: {{ post.author }}</span>{% endif %}
    </div>
  </header>

  <div class="post-content">
    {{ post.content | safe }}
  </div>
</article>
