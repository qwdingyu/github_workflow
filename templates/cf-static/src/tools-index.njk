---
layout: base.njk
title: All Tools
description: Free online developer tools collection
eleventyComputed:
  canonical: "{{ config.url }}/tools-index/"
---

<section class="tools-list">
  <h1>All Tools</h1>
  <p class="description">Free online developer tools — all operations run in your browser</p>

  <div class="tools-grid">
    {% for tool in tools %}
    <a href="/tools/{{ tool.slug }}/" class="tool-card">
      <span class="tool-icon">{{ tool.icon | default('🔧') }}</span>
      <h3>{{ tool.title }}</h3>
      <p>{{ tool.description }}</p>
      {% if tool.category %}
      <span class="tool-category">{{ tool.category }}</span>
      {% endif %}
    </a>
    {% endfor %}
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "All Tools",
  "description": "Free online developer tools including formatters, encoders, hash generators, text processors, and utilities",
  "url": "{{ config.url }}/tools-index/",
  "hasPart": [
    {% for tool in tools %}
    {
      "@type": "SoftwareApplication",
      "name": "{{ tool.title }}",
      "url": "{{ config.url }}/tools/{{ tool.slug }}/"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
