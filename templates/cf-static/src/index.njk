---
layout: base.njk
permalink: /
eleventyComputed:
  title: "{{ config.siteName }}"
  description: "{{ config.description }}"
  canonical: "{{ config.url }}/"
---

<section class="hero">
  <h1>{{ config.siteName }}</h1>
  <p>{{ config.description }}</p>
</section>

<!-- Featured Tools -->
<section class="tools-grid">
  {% for tool in tools %}
  {% if loop.index0 < 6 %}
  <a href="/tools/{{ tool.slug }}/" class="tool-card">
    <span class="tool-icon">{{ tool.icon | default('🔧') }}</span>
    <h3>{{ tool.title }}</h3>
    <p>{{ tool.description }}</p>
    {% if tool.category %}
    <span class="tool-category">{{ tool.category }}</span>
    {% endif %}
  </a>
  {% endif %}
  {% endfor %}
</section>
<p style="text-align:center;margin-top:1.5rem"><a href="/tools-index/" style="color:var(--accent)">View all {{ tools | length }} tools →</a></p>

<!-- SEO Content Section -->
<section class="seo-content" aria-label="About Us">
  <h2>Why Choose DevTools?</h2>
  <div class="features">
    <article>
      <h3>🔒 Privacy First</h3>
      <p>All tools run entirely in your browser. No data is sent to any server. Your information stays safe on your device — no privacy concerns.</p>
    </article>
    <article>
      <h3>⚡ Lightning Fast</h3>
      <p>Built as a static site for blazing-fast page loads. No backend processing to wait for — all computations happen instantly in your browser.</p>
    </article>
    <article>
      <h3>🆓 100% Free</h3>
      <p>All features are completely free with no registration required and no usage limits. Perfect for individual developers and teams alike.</p>
    </article>
    <article>
      <h3>📱 Cross-Platform</h3>
      <p>Responsive design works on all devices — desktop, tablet, and mobile. Consistent great experience everywhere.</p>
    </article>
  </div>
</section>
