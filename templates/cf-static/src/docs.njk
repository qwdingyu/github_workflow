---
layout: base.njk
pagination:
  data: docs
  size: 1
  alias: doc
permalink: "/docs/{{ doc.slug }}/"
eleventyComputed:
  title: "{{ doc.title }}"
  description: "{{ doc.description }}"
  canonical: "{{ config.url }}{{ page.url }}"
---

<article class="doc">
  <header>
    <h1>{{ doc.title }}</h1>
  </header>

  <div class="doc-content">
    {{ doc.content | safe }}
  </div>
</article>
