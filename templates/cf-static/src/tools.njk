---
layout: base.njk
pagination:
  data: tools
  size: 1
  alias: tool
permalink: "/tools/{{ tool.slug }}/"
eleventyComputed:
  title: "{{ tool.title }}"
  description: "{{ tool.description }}"
  keywords: "{% if tool.keywords %}{{ tool.keywords | join(', ') }}{% endif %}"
  canonical: "{{ config.url }}{{ page.url }}"
---

<section class="tool-page">
  <article>
    <header>
      <h1>{{ tool.title }}</h1>
      <p class="description">{{ tool.description }}</p>
    </header>

    {% if tool.type == 'calculator' %}
    {% include tool.slug ~ '.njk' %}
    <script src="/assets/js/utils.js" defer></script>
    <script src="/assets/js/{{ tool.slug }}.js" defer></script>
    {% else %}
    <form class="tool-content tool-form" onsubmit="processTool(); return false;">
      <div class="tool-area">
        <div class="tool-input">
          {% if tool.slug == 'regex-tester' %}
          <label for="input">正则表达式</label>
          <input type="text" id="input" placeholder="输入正则表达式，如 \d+">
          <label for="test-string">测试文本</label>
          <textarea id="test-string" rows="4" placeholder="输入要测试的文本"></textarea>
          <label for="flags">标志</label>
          <input type="text" id="flags" value="g" placeholder="如 g, gi, gm">
          {% elif tool.slug == 'uuid-generator' %}
          <label for="count">生成数量 (1-100)</label>
          <input type="number" id="count" value="1" min="1" max="100">
          {% elif tool.slug == 'base64-decode' %}
          <div class="mode-toggle">
            <label><input type="radio" name="mode" value="encode" checked> Base64 编码</label>
            <label><input type="radio" name="mode" value="decode"> Base64 解码</label>
          </div>
          {% elif tool.slug == 'url-encode-decode' %}
          <div class="mode-toggle">
            <label><input type="radio" name="mode" value="encode" checked> URL 编码</label>
            <label><input type="radio" name="mode" value="decode"> URL 解码</label>
          </div>
          {% elif tool.slug == 'html-escape' %}
          <div class="mode-toggle">
            <label><input type="radio" name="mode" value="escape" checked> HTML 转义</label>
            <label><input type="radio" name="mode" value="unescape"> HTML 反转义</label>
          </div>
          <textarea id="input" rows="6" placeholder="输入要转义或反转义的文本..."></textarea>
          {% else %}
          <textarea id="input" rows="6" placeholder="输入要处理的文本..."></textarea>
          {% endif %}
        </div>

        <div class="tool-actions">
          <button type="submit" class="btn-primary">处理</button>
          <button type="button" class="btn-secondary" onclick="copyOutput()">复制结果</button>
          <button type="button" class="btn-secondary" onclick="clearAll()">清空</button>
        </div>

        <div class="tool-output">
          {% if tool.slug == 'uuid-generator' %}
          <textarea id="output" rows="6" readonly placeholder="点击&#x27;处理&#x27;生成 UUID..."></textarea>
          {% else %}
          <textarea id="output" rows="6" readonly placeholder="结果将显示在这里..."></textarea>
          {% endif %}
        </div>
      </div>
    </form>
    <script src="/assets/js/{{ tool.slug }}.js" defer></script>
    {% endif %}

    {% if tool.faq and tool.faq.length > 0 %}
    <section class="faq">
      <h2>常见问题</h2>
      {% for item in tool.faq %}
      <details>
        <summary>{{ item.question }}</summary>
        <p>{{ item.answer }}</p>
      </details>
      {% endfor %}
    </section>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for item in tool.faq %}
        {
          "@type": "Question",
          "name": "{{ item.question }}",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "{{ item.answer }}"
          }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
    </script>
    {% endif %}

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "{{ tool.title }}",
      "url": "{{ canonical | default(config.url ~ page.url) }}",
      "description": "{{ tool.description }}",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "CNY"
      }
    }
    </script>

    <section class="related-tools">
      <h2>相关工具</h2>
      <div class="related-tools-grid">
        {% set related_count = 0 %}
        {% for related in tools %}
        {% if related.slug != tool.slug and related.category == tool.category and related_count < 3 %}
        <a href="/tools/{{ related.slug }}/" class="related-tool-card">
          <span class="tool-icon">{{ related.icon | default('🔧') }}</span>
          <h4>{{ related.title }}</h4>
        </a>
        {% set related_count = related_count + 1 %}
        {% endif %}
        {% endfor %}
      </div>
    </section>
  </article>
</section>
