---
layout: base.njk
pagination:
  data: tools
  size: 1
  alias: tool
permalink: "/tools/{{ tool.slug }}/"
eleventyComputed:
  title: "{{ tool.title }}"
  description: "{{ tool.description }}"
  keywords: "{% if tool.keywords %}{{ tool.keywords | join(', ') }}{% endif %}"
  canonical: "{{ config.url }}{{ page.url }}"
---

<section class="tool-page">
  <article>
    <header>
      <h1>{{ tool.title }}</h1>
      <p class="description">{{ tool.description }}</p>
    </header>

    <form class="tool-content tool-form" onsubmit="processTool(); return false;">
      <div class="tool-area">
        <div class="tool-input">
          {% if tool.slug == 'regex-tester' %}
          <label for="input">Regular Expression</label>
          <input type="text" id="input" placeholder="e.g. \d+">
          <label for="test-string">Test String</label>
          <textarea id="test-string" rows="4" placeholder="Enter text to test"></textarea>
          <label for="flags">Flags</label>
          <input type="text" id="flags" value="g" placeholder="e.g. g, gi, gm">
          {% elif tool.slug == 'uuid-generator' %}
          <label for="count">Count (1-100)</label>
          <input type="number" id="count" value="1" min="1" max="100">
          {% elif tool.slug == 'base64-decode' %}
          <div class="mode-toggle">
            <label><input type="radio" name="mode" value="encode" checked> Base64 Encode</label>
            <label><input type="radio" name="mode" value="decode"> Base64 Decode</label>
          </div>
          {% elif tool.slug == 'url-encode-decode' %}
          <div class="mode-toggle">
            <label><input type="radio" name="mode" value="encode" checked> URL Encode</label>
            <label><input type="radio" name="mode" value="decode"> URL Decode</label>
          </div>
          {% elif tool.slug == 'html-escape' %}
          <div class="mode-toggle">
            <label><input type="radio" name="mode" value="escape" checked> HTML Escape</label>
            <label><input type="radio" name="mode" value="unescape"> HTML Unescape</label>
          </div>
          <textarea id="input" rows="6" placeholder="Enter text to escape or unescape..."></textarea>
          {% else %}
          <textarea id="input" rows="6" placeholder="Enter text to process..."></textarea>
          {% endif %}
        </div>

        <div class="tool-actions">
          <button type="submit" class="btn-primary">Process</button>
          <button type="button" class="btn-secondary" onclick="copyOutput()">Copy</button>
          <button type="button" class="btn-secondary" onclick="clearAll()">Clear</button>
        </div>

        <div class="tool-output">
          {% if tool.slug == 'uuid-generator' %}
          <textarea id="output" rows="6" readonly placeholder="Click 'Process' to generate UUID..."></textarea>
          {% else %}
          <textarea id="output" rows="6" readonly placeholder="Result will appear here..."></textarea>
          {% endif %}
        </div>
      </div>
    </form>
    <script src="/assets/js/{{ tool.slug }}.js" defer></script>

    {% if tool.faq and tool.faq.length > 0 %}
    <section class="faq">
      <h2>Frequently Asked Questions</h2>
      {% for item in tool.faq %}
      <details>
        <summary>{{ item.question }}</summary>
        <p>{{ item.answer }}</p>
      </details>
      {% endfor %}
    </section>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for item in tool.faq %}
        {
          "@type": "Question",
          "name": "{{ item.question }}",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "{{ item.answer }}"
          }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
    </script>
    {% endif %}

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "{{ tool.title }}",
      "url": "{{ canonical | default(config.url ~ page.url) }}",
      "description": "{{ tool.description }}",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
    </script>

    <section class="related-tools">
      <h2>Related Tools</h2>
      <div class="related-tools-grid">
        {% set related_count = 0 %}
        {% for related in tools %}
        {% if related.slug != tool.slug and related.category == tool.category and related_count < 3 %}
        <a href="/tools/{{ related.slug }}/" class="related-tool-card">
          <span class="tool-icon">{{ related.icon | default('🔧') }}</span>
          <h4>{{ related.title }}</h4>
        </a>
        {% set related_count = related_count + 1 %}
        {% endif %}
        {% endfor %}
      </div>
    </section>
  </article>
</section>
