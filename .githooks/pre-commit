#!/bin/sh
# ── eForge Monorepo Pre-commit Hook ──────────────────────────────────────────
# 在提交前自动运行架构验证，违规提交会被阻断。
# 安装：git config core.hooksPath .githooks
# 跳过：SKIP_ARCH=1 git commit -m "跳过验证的特殊提交"
# ──────────────────────────────────────────────────────────────────────────────

set -e

if [ -n "$SKIP_ARCH" ]; then
  echo "[arch-hook] SKIP_ARCH 已设置，跳过架构验证"
  exit 0
fi

echo "[arch-hook] 🔍 运行架构合规性验证..."

# 找到项目根目录（相对于 .git/hooks 的上级是项目根）
HOOK_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# 只检查 staged 文件中涉及 schema.ts / package.json / package-lock.json 的变更
STAGED_FILES=$(git diff --cached --name-only)

HAS_SCHEMA_CHANGE=false
HAS_LOCK_CHANGE=false

for f in $STAGED_FILES; do
  case "$f" in
    *schema.ts) HAS_SCHEMA_CHANGE=true ;;
    package-lock.json)
      echo "[arch-hook] ❌ package-lock.json 被暂存！禁止提交 npm/yarn 的 lock 文件。"
      echo "   请使用 pnpm install 并删除 package-lock.json"
      exit 1
      ;;
  esac
done

# 如果有 schema 变更，运行完整架构验证
if [ "$HAS_SCHEMA_CHANGE" = true ]; then
  echo "[arch-hook]   检测到 schema.ts 变更，正在验证..."
  cd "$HOOK_DIR"
  node scripts/validate-architecture.mjs || {
    echo "[arch-hook] ❌ 架构验证未通过。使用 SKIP_ARCH=1 可跳过此检查。"
    exit 1
  }
fi

echo "[arch-hook] ✅ 架构验证通过"
exit 0
